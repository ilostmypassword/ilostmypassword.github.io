---
import { Image } from "astro:assets";
import MusicPlayer from "./MusicPlayer.astro";
import { SITE, SOCIALS } from "../consts";
import { getPosts, url } from "../utils/posts";
import { getGithubStars, getLastPush } from "../utils/github";

const ghUser = SITE.links.github.split("/").pop()!;
const stars = await getGithubStars(ghUser);
const lastPush = await getLastPush(ghUser);
const [latestPost] = await getPosts();

// Drop a picture at src/assets/profile.(jpg|jpeg|png|webp) (or avatar.*) to show it here.
// Without one, the hexagon logo is displayed instead.
const avatars = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/{profile,avatar}.{jpg,jpeg,png,webp}",
    { eager: true },
);
const avatar = Object.values(avatars)[0]?.default;

const ICONS: Record<string, string> = {
    github: `<path fill="currentColor" d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/>`,
    yeswehack: `<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/><path d="M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4"/></g>`,
    rss: `<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="5.5" cy="18.5" r="1.2" fill="currentColor"/><path d="M4.5 11a8.5 8.5 0 0 1 8.5 8.5M4.5 4.5A15 15 0 0 1 19.5 19.5"/></g>`,
    mail: `<g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></g>`,
};

const links = SOCIALS.map((s) => ({
    label: s.label,
    href: s.href,
    icon: s.icon,
}));
---

<aside class="sidebar" aria-label="Site information">
    <div class="sidebar-inner">
        <div class="status" aria-hidden="true">
            <span class="status-live">
                <i class="status-dot"></i>online
            </span>
            <span class="status-clock">
                {SITE.location} <time data-clock>--:--:--</time>
            </span>
        </div>

        <a class="profile" href={url("/")}>
            <span class="avatar-glow">
                <span class="avatar-frame">
                    {avatar ? (
                        <Image
                            class="avatar"
                            src={avatar}
                            width={160}
                            height={160}
                            alt={`Portrait of ${SITE.author}`}
                        />
                    ) : (
                        <span class="avatar avatar-fallback" aria-hidden="true">
                            <svg width="40" height="40" viewBox="0 0 24 24">
                                <path
                                    d="M12 2.2 20.5 7v10L12 21.8 3.5 17V7z"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linejoin="round"
                                />
                                <path
                                    d="M12 8.2 16 10.5v3L12 15.8 8 13.5v-3z"
                                    fill="currentColor"
                                />
                            </svg>
                        </span>
                    )}
                </span>
            </span>
            <span class="profile-text">
                <span class="profile-name">
                    {SITE.title}
                    <i class="caret" aria-hidden="true">
                        _
                    </i>
                </span>
                <span class="profile-role">{SITE.focus.join(" / ")}</span>
            </span>
        </a>

        <figure class="sidebar-quote">
            <blockquote>
                <p>{SITE.quote.text}</p>
            </blockquote>
            <figcaption>{SITE.quote.author}</figcaption>
        </figure>

        <section class="side-section side-links" aria-labelledby="side-links">
            <h2 class="side-title" id="side-links">
                <span class="side-idx">01</span> Elsewhere
            </h2>
            <ul class="socials">
                {links.map((l) => (
                    <li>
                        <a
                            href={l.href}
                            aria-label={l.label}
                            rel={
                                l.href.startsWith("http")
                                    ? "me noopener"
                                    : undefined
                            }
                            target={
                                l.href.startsWith("http") ? "_blank" : undefined
                            }
                        >
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                                set:html={ICONS[l.icon]}
                            />
                            <span>{l.label}</span>
                            {l.icon === "github" && stars !== null && (
                                <span class="stars" title="Total GitHub stars">
                                    <svg
                                        class="star-icon"
                                        width="15"
                                        height="15"
                                        viewBox="0 0 24 24"
                                        aria-hidden="true"
                                    >
                                        <path
                                            fill="currentColor"
                                            d="M12 2.6l2.95 6.07 6.65.9-4.85 4.64 1.2 6.6L12 17.55 6.05 20.8l1.2-6.6L2.4 9.57l6.65-.9z"
                                        />
                                    </svg>
                                    <span>{stars}</span>
                                </span>
                            )}
                            {l.icon === "mail" ? (
                                <span class="arrow" aria-hidden="true">
                                    →
                                </span>
                            ) : (
                                <span class="arrow" aria-hidden="true">
                                    ↗
                                </span>
                            )}
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        <MusicPlayer />

        {(latestPost || lastPush) && (
            <section
                class="side-section side-activity"
                aria-labelledby="side-activity"
            >
                <h2 class="side-title" id="side-activity">
                    <span class="side-idx">03</span> Activity
                </h2>
                <ul class="activity">
                    {latestPost && (
                        <li>
                            <span class="act-head">
                                <span class="act-k">Latest post</span>
                                <time
                                    class="act-ago"
                                    datetime={latestPost.data.date.toISOString()}
                                    data-ago
                                >
                                    {latestPost.data.date
                                        .toISOString()
                                        .slice(0, 10)}
                                </time>
                            </span>
                            <a href={url(`/posts/${latestPost.id}/`)}>
                                {latestPost.data.title}
                            </a>
                        </li>
                    )}
                    {lastPush && (
                        <li>
                            <span class="act-head">
                                <span class="act-k">Last push</span>
                                <time
                                    class="act-ago"
                                    datetime={lastPush.at}
                                    data-ago
                                >
                                    {lastPush.at.slice(0, 10)}
                                </time>
                            </span>
                            <a
                                href={lastPush.url}
                                title={lastPush.message ?? lastPush.repo}
                            >
                                {lastPush.repo}
                                {lastPush.message && (
                                    <span class="act-msg">
                                        {" "}
                                        · {lastPush.message}
                                    </span>
                                )}
                            </a>
                        </li>
                    )}
                </ul>
            </section>
        )}

        <p class="sidebar-foot">
            &copy; {new Date().getFullYear()} {SITE.author}
            <br />
            {SITE.location} · built with Astro
        </p>
    </div>
</aside>

<script>
    // Live clock (Paris time). One interval for the whole session; the
    // sidebar is re-rendered on every page, so it re-queries each tick.
    const fmt = new Intl.DateTimeFormat("en-GB", {
        timeZone: "Europe/Paris",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
    });
    const tick = () => {
        const now = fmt.format(new Date());
        document
            .querySelectorAll<HTMLElement>("[data-clock]")
            .forEach((el) => (el.textContent = now));
    };
    tick();
    setInterval(tick, 1000);
    document.addEventListener("astro:page-load", tick);

    // "3d ago" labels (build-time dates, rendered relative to now).
    const ago = () => {
        const now = Date.now();
        document
            .querySelectorAll<HTMLTimeElement>("[data-ago]")
            .forEach((el) => {
                const s = Math.max(0, (now - Date.parse(el.dateTime)) / 1000);
                const units: [number, string][] = [
                    [31536000, "y"],
                    [2592000, "mo"],
                    [86400, "d"],
                    [3600, "h"],
                    [60, "min"],
                ];
                const u = units.find(([n]) => s >= n);
                el.textContent = u
                    ? `${Math.floor(s / u[0])}${u[1]} ago`
                    : "just now";
            });
    };
    ago();
    document.addEventListener("astro:page-load", ago);
</script>

---
import { KINDS, SOCIALS } from "../consts";
import { getPosts, url } from "../utils/posts";

interface Item {
    label: string;
    hint: string;
    group: string;
    href?: string;
    external?: boolean;
    action?: "toggle-music" | "next-track";
}

const posts = await getPosts();

const items: Item[] = [
    ...posts.map((p) => ({
        label: p.data.title,
        hint: p.data.locked ? "Encrypted" : KINDS[p.data.kind],
        group: "Articles",
        href: url(`/posts/${p.id}/`),
    })),
    { label: "Home", hint: "Page", group: "Go to", href: url("/") },
    { label: "Articles", hint: "Page", group: "Go to", href: url("/posts/") },
    { label: "About", hint: "Page", group: "Go to", href: url("/about/") },
    {
        label: "RSS feed",
        hint: "Feed",
        group: "Go to",
        href: url("/rss.xml"),
        external: true,
    },
    ...SOCIALS.map((s) => ({
        label: s.label,
        hint: "External",
        group: "Elsewhere",
        href: s.href,
        external: true,
    })),
    {
        label: "Play / pause music",
        hint: "Player",
        group: "Actions",
        action: "toggle-music" as const,
    },
    {
        label: "Next track",
        hint: "Player",
        group: "Actions",
        action: "next-track" as const,
    },
];
---

<dialog
    class="palette"
    id="palette"
    aria-label="Search and commands"
    transition:persist="palette"
>
    <div class="palette-box">
        <div class="palette-head">
            <span class="palette-prompt" aria-hidden="true">
                &gt;
            </span>
            <input
                class="palette-input"
                type="text"
                placeholder="Search articles, pages, actions…"
                autocomplete="off"
                spellcheck="false"
                role="combobox"
                aria-expanded="true"
                aria-controls="palette-list"
                aria-label="Search"
            />
            <kbd>Esc</kbd>
        </div>
        <ul class="palette-list" id="palette-list" role="listbox"></ul>
        <div class="palette-foot" aria-hidden="true">
            <span>
                <kbd>↑</kbd>
                <kbd>↓</kbd> navigate
            </span>
            <span>
                <kbd>↵</kbd> open
            </span>
            <span>
                <kbd>Ctrl</kbd>
                <kbd>K</kbd> toggle
            </span>
        </div>
    </div>
    <script
        type="application/json"
        data-items
        set:html={JSON.stringify(items)}
    ></script>
</dialog>

<script>
    import { navigate } from "astro:transitions/client";

    interface Item {
        label: string;
        hint: string;
        group: string;
        href?: string;
        external?: boolean;
        action?: "toggle-music" | "next-track";
    }

    const dialog = document.getElementById(
        "palette",
    ) as HTMLDialogElement | null;

    if (dialog) {
        const input = dialog.querySelector<HTMLInputElement>(".palette-input")!;
        const list = dialog.querySelector<HTMLUListElement>(".palette-list")!;
        const items: Item[] = JSON.parse(
            dialog.querySelector("[data-items]")!.textContent || "[]",
        );

        let results: Item[] = [];
        let active = 0;

        // Substring match beats subsequence match; null = no match.
        const score = (query: string, text: string): number | null => {
            if (!query) return 0;
            const q = query.toLowerCase();
            const t = text.toLowerCase();
            const at = t.indexOf(q);
            if (at >= 0) return 1000 - at - t.length * 0.1;
            let pos = 0;
            let gaps = 0;
            for (const ch of q) {
                const found = t.indexOf(ch, pos);
                if (found < 0) return null;
                gaps += found - pos;
                pos = found + 1;
            }
            return 500 - gaps;
        };

        const filter = () => {
            const q = input.value.trim();
            if (!q) {
                results = items.slice();
            } else {
                results = items
                    .map((item) => ({
                        item,
                        s: score(q, `${item.label} ${item.hint}`),
                    }))
                    .filter((r) => r.s !== null)
                    .sort((a, b) => (b.s as number) - (a.s as number))
                    .map((r) => r.item);
            }
            active = 0;
            render();
        };

        const render = () => {
            list.replaceChildren();
            if (!results.length) {
                const li = document.createElement("li");
                li.className = "palette-empty";
                li.textContent = "No match.";
                list.append(li);
                input.removeAttribute("aria-activedescendant");
                return;
            }
            let lastGroup = "";
            results.forEach((item, i) => {
                if (item.group !== lastGroup) {
                    lastGroup = item.group;
                    const h = document.createElement("li");
                    h.className = "palette-group";
                    h.setAttribute("role", "presentation");
                    h.textContent = item.group;
                    list.append(h);
                }
                const li = document.createElement("li");
                li.className = "palette-item";
                li.id = `palette-opt-${i}`;
                li.setAttribute("role", "option");
                li.setAttribute("aria-selected", String(i === active));
                li.dataset.index = String(i);
                const label = document.createElement("span");
                label.className = "palette-label";
                label.textContent = item.label;
                const hint = document.createElement("span");
                hint.className = "palette-hint";
                hint.textContent = item.hint;
                li.append(label, hint);
                list.append(li);
            });
            input.setAttribute(
                "aria-activedescendant",
                `palette-opt-${active}`,
            );
        };

        const setActive = (next: number) => {
            if (!results.length) return;
            active = (next + results.length) % results.length;
            list.querySelectorAll<HTMLElement>(".palette-item").forEach(
                (el) => {
                    const on = Number(el.dataset.index) === active;
                    el.setAttribute("aria-selected", String(on));
                    if (on) el.scrollIntoView({ block: "nearest" });
                },
            );
            input.setAttribute(
                "aria-activedescendant",
                `palette-opt-${active}`,
            );
        };

        const open = () => {
            if (dialog.open) return;
            input.value = "";
            filter();
            dialog.showModal();
            input.focus();
        };
        const close = () => {
            if (dialog.open) dialog.close();
        };

        const run = (item: Item | undefined) => {
            if (!item) return;
            close();
            if (item.action === "toggle-music") {
                document
                    .querySelector<HTMLElement>(".player [data-play]")
                    ?.click();
            } else if (item.action === "next-track") {
                document
                    .querySelector<HTMLElement>(".player [data-next]")
                    ?.click();
            } else if (item.href) {
                if (item.external) window.open(item.href, "_blank", "noopener");
                else navigate(item.href);
            }
        };

        input.addEventListener("input", filter);
        input.addEventListener("keydown", (e) => {
            if (e.key === "ArrowDown") {
                e.preventDefault();
                setActive(active + 1);
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                setActive(active - 1);
            } else if (e.key === "Enter") {
                e.preventDefault();
                run(results[active]);
            }
        });

        list.addEventListener("pointermove", (e) => {
            const li = (e.target as Element).closest<HTMLElement>(
                ".palette-item",
            );
            if (li && Number(li.dataset.index) !== active)
                setActive(Number(li.dataset.index));
        });
        list.addEventListener("click", (e) => {
            const li = (e.target as Element).closest<HTMLElement>(
                ".palette-item",
            );
            if (li) run(results[Number(li.dataset.index)]);
        });

        // Click on the backdrop (outside the box) closes.
        dialog.addEventListener("click", (e) => {
            if (e.target === dialog) close();
        });

        document.addEventListener("keydown", (e) => {
            const t = e.target as HTMLElement | null;
            const typing =
                !!t &&
                (t.isContentEditable ||
                    /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                dialog.open ? close() : open();
            } else if (
                e.key === "/" &&
                !typing &&
                !dialog.open &&
                !e.ctrlKey &&
                !e.metaKey &&
                !e.altKey
            ) {
                e.preventDefault();
                open();
            }
        });

        document.addEventListener("click", (e) => {
            if ((e.target as Element).closest("[data-open-palette]")) open();
        });
    }
</script>
